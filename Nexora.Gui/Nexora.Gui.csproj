<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Nexora</AssemblyName>
    <Product>Nexora</Product>
    <AssemblyTitle>Nexora</AssemblyTitle>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.6.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Nexora_Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NexoraDev)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXORA_DEV</DefineConstants>
  </PropertyGroup>
  <!-- Fortress migration is disabled by default in production until reviewed and tested. -->
  <PropertyGroup Condition="'$(NexoraFortressPreview)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXORA_FORTRESS_PREVIEW</DefineConstants>
  </PropertyGroup>
  <!-- The full diagnostic implementation lives in the separate, private nexora-dev folder. -->
  <ItemGroup Condition="'$(NexoraDev)' == 'true'">
    <Compile Include="..\..\nexora-dev\Nexora.Dev\DevCtapLogTarget.cs" Link="DevTools\DevCtapLogTarget.cs" />
  </ItemGroup>
  <Target Name="RequirePrivateDevExtension" BeforeTargets="CoreCompile" Condition="'$(NexoraDev)' == 'true'">
    <Error Condition="!Exists('..\..\nexora-dev\Nexora.Dev\DevCtapLogTarget.cs')"
           Text="Extension Nexora DEV privée manquante : nexora-dev/Nexora.Dev/DevCtapLogTarget.cs" />
  </Target>
  <ItemGroup>
    <Compile Remove="Security\LocalPinGuard.cs" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="nlog.config" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\nexora-usb\Nexora.Usb\Nexora.Usb.csproj" />
    <ProjectReference Include="..\..\nexora-fido\Nexora.Fido\Nexora.Fido.csproj" />
    <ProjectReference Include="..\..\nexora-fido\Nexora.SecretManager.VaultSecretStore\Nexora.SecretManager.VaultSecretStore.csproj" />
    <ProjectReference Include="..\..\nexora-crypt\Nexora.Crypt\Nexora.Crypt.csproj" />
    <ProjectReference Include="..\..\nexora-fido\Nexora.SecretManager.MtlsBasedSecretStoreClient\Nexora.SecretManager.MtlsBasedSecretStoreClient.csproj" />
  </ItemGroup>
</Project>
