<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Gui.Updates.UpdateWindow"
        Icon="avares://Nexora/Assets/Nexora_Icon.png"
        Title="Nexora · Centre de mise à jour"
        Width="800" Height="730" MinWidth="680" MinHeight="610"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="#090D18" RequestedThemeVariant="Dark">
    <!-- Critical UX: Release notes take the only star-sized row. Controls remain visible. -->
    <Grid Margin="24,19,24,22" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
            <Border Width="55" Height="55" Background="#251E42" BorderBrush="#594381"
                    BorderThickness="1" CornerRadius="13" Padding="8" VerticalAlignment="Center">
                <Image Source="avares://Nexora/Assets/Nexora_Icon.png" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="5" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NEXORA  /  RELEASE CENTER" FontSize="10" FontWeight="Bold" Foreground="#B69DFB"/>
                <TextBlock x:Name="VersionLabel" Text="Nexora" FontSize="25" FontWeight="Bold" Foreground="#F6F5FF"/>
                <TextBlock Text="Nouvelle version disponible sur GitHub Releases" FontSize="11" Foreground="#9EB1CD"/>
            </StackPanel>
            <Border Grid.Column="2" Background="#173532" BorderBrush="#306762" BorderThickness="1"
                    CornerRadius="15" Padding="12,7" VerticalAlignment="Center" Margin="9,0,0,0">
                <TextBlock x:Name="ReleaseChannelLabel" Text="STABLE" FontSize="10"
                           FontWeight="Bold" Foreground="#8DE8DA"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="#131E31" BorderBrush="#2D3B56" BorderThickness="1"
                CornerRadius="13" Padding="18,15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="INSTALLÉE" FontSize="10" FontWeight="Bold" Foreground="#8DA2C4"/>
                    <TextBlock x:Name="InstalledVersionLabel" Text="—" FontSize="19" FontWeight="Bold" Foreground="#E7EFFF"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5" Margin="13,0,0,0">
                    <TextBlock Text="DISPONIBLE" FontSize="10" FontWeight="Bold" Foreground="#8DA2C4"/>
                    <TextBlock x:Name="AvailableVersionLabel" Text="—" FontSize="19" FontWeight="Bold" Foreground="#C4ADFF"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" Margin="13,0,0,0">
                    <TextBlock Text="TAILLE" FontSize="10" FontWeight="Bold" Foreground="#8DA2C4"/>
                    <TextBlock x:Name="PackageSizeLabel" Text="—" FontSize="19" FontWeight="Bold" Foreground="#E7EFFF"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#111A2D" BorderBrush="#29364F" BorderThickness="1"
                CornerRadius="13" Padding="16,14" Margin="0,0,0,14" MinHeight="100">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="Notes de version" FontSize="15" FontWeight="SemiBold" Foreground="#F2E8FF"/>
                    <TextBlock Grid.Column="1" Text="DÉFILER ↓" FontSize="10" Foreground="#859AB9" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReleaseNotesPanel" Spacing="8" Margin="0,0,9,0"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="#161F34" BorderBrush="#2C3A55" BorderThickness="1"
                CornerRadius="12" Padding="13,11" Margin="0,0,0,12">
            <StackPanel Spacing="4">
                <CheckBox x:Name="AutomaticCheck"
                          Content="Installer automatiquement les prochaines mises à jour"
                          FontSize="12" Checked="AutomaticChanged" Unchecked="AutomaticChanged"/>
                <TextBlock Text="Les clés USB/IP doivent être déconnectées avant toute installation."
                           TextWrapping="Wrap" Foreground="#94A9C8" FontSize="11" Margin="26,0,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="4" Background="#14202F" BorderBrush="#30415A" BorderThickness="1"
                CornerRadius="12" Padding="13,11" Margin="0,0,0,13">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                <TextBlock x:Name="StageLabel" Grid.Row="0" Grid.Column="0" Text="EN ATTENTE"
                           FontSize="10" FontWeight="Bold" Foreground="#74E4D6" Margin="0,2,0,0"/>
                <TextBlock x:Name="StatusLabel" Grid.Row="0" Grid.Column="1"
                           Text="Prêt à télécharger et vérifier la mise à jour."
                           Foreground="#C3D2E9" FontSize="11" TextWrapping="Wrap" Margin="15,0,0,0"/>
                <ProgressBar x:Name="DownloadProgress" Grid.Row="1" Grid.ColumnSpan="2"
                             Minimum="0" Maximum="100" Height="6" Margin="0,11,0,0" IsVisible="False"/>
            </Grid>
        </Border>
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto">
            <Button x:Name="ChangelogButton" Grid.Column="0" Classes="quiet"
                    Content="↗  Notes sur GitHub" HorizontalAlignment="Left" Click="Changelog_Click"/>
            <Button x:Name="LaterButton" Grid.Column="1" Content="Plus tard"
                    Margin="9,0,0,0" MinWidth="105" Click="Later_Click"/>
            <Button x:Name="InstallButton" Grid.Column="2" Classes="accent"
                    Content="Installer maintenant" Margin="10,0,0,0" MinWidth="172" Click="Install_Click"/>
        </Grid>
    </Grid>
</Window>
