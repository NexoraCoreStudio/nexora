<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Gui.UserPresence.ApprovalWindow"
        Title="Nexora · Autorisation"
        Icon="avares://Nexora/Assets/Nexora_Icon.png"
        Width="470" Height="460" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="True" Background="#101A2A"
        RequestedThemeVariant="Dark">
    <Border Background="#101A2A" Padding="25" CornerRadius="16">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="13">
                <Image Source="avares://Nexora/Assets/Nexora_Icon.png"
                       Width="69" Height="69" Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="NEXORA  /  VÉRIFICATION" FontSize="12" FontWeight="Bold" Foreground="#C39AFF" />
                    <TextBlock Text="Valider la demande" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="DeviceText" FontSize="12" Foreground="#9FB3D0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,24,0,14" Spacing="12">
                <TextBlock x:Name="OperationText" FontSize="15" FontWeight="SemiBold" Foreground="#EEF6FF" TextWrapping="Wrap" />
                <Border Background="#1C3047" CornerRadius="11" Padding="14,12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SERVICE DEMANDEUR" FontSize="10" Foreground="#89A0BD" />
                        <TextBlock x:Name="RpText" FontSize="17" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Entrez votre PIN pour confirmer cette demande" FontSize="12" Foreground="#B8CBE2" />
                <TextBox x:Name="ApprovalPin" PasswordChar="●" MaxLength="4" Watermark="••••" HorizontalContentAlignment="Center" FontSize="18" KeyDown="ApprovalPin_KeyDown" />
                <TextBlock x:Name="ApprovalError" FontSize="11" Foreground="#FF8E99" IsVisible="False" TextWrapping="Wrap" />
                <ProgressBar x:Name="CountdownBar" Minimum="0" Maximum="30" Value="30" Height="5" Foreground="#AD80FA" />
                <TextBlock x:Name="CountdownText" Text="Refus automatique dans 30 s" HorizontalAlignment="Right" FontSize="11" Foreground="#95A8C1" />
            </StackPanel>
            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="Refuser" Click="Deny_Click" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Margin="10,0,0,0" Classes="accent" Content="Autoriser" Click="Approve_Click" HorizontalContentAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
