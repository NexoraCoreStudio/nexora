<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexora.Gui.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#263449" />
            <Setter Property="Foreground" Value="#EAF3FF" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#334762" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#A978F4" />
            <Setter Property="Foreground" Value="#0B0F20" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#D0B1FF" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1A283B" />
            <Setter Property="BorderBrush" Value="#304560" />
            <Setter Property="Foreground" Value="#F0F7FF" />
            <Setter Property="Padding" Value="13,11" />
        </Style>
    </Application.Styles>
</Application>
