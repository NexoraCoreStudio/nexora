<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false" internalLogLevel="Off">
  <!-- Nexora 1.2 does not persist operational logs outside Nexora.vault. -->
  <targets>
    <target name="debugger" xsi:type="Debugger" layout="${level}: ${message}" />
  </targets>
  <rules>
    <logger name="*" minlevel="Warn" writeTo="debugger" />
  </rules>
</nlog>
