<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Gui.Dialogs.PasswordPromptWindow"
        Width="445" SizeToContent="Height" MaxHeight="650"
        CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0B1020" RequestedThemeVariant="Dark">
    <StackPanel Margin="27" Spacing="14">
        <TextBlock Text="NEXORA  /  ACCÈS PROTÉGÉ" FontSize="10" FontWeight="Bold" Foreground="#A88BFA"/>
        <TextBlock Text="Accéder à l'authentificateur" FontSize="21" FontWeight="Bold" Foreground="#F4F6FF"/>
        <Border Background="#18233A" BorderBrush="#35425E" BorderThickness="1" CornerRadius="11" Padding="13,12">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="#B5C7E2" FontSize="12"/>
        </Border>
        <StackPanel x:Name="UsernamePanel" Spacing="6">
            <TextBlock Text="UTILISATEUR" FontSize="10" Foreground="#9CB1CE" FontWeight="Bold"/>
            <TextBox x:Name="UsernameBox" Watermark="Nom d'utilisateur"/>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="MOT DE PASSE" FontSize="10" Foreground="#9CB1CE" FontWeight="Bold"/>
            <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Mot de passe"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Annuler" Click="Cancel_Click"/>
            <Button Grid.Column="1" Classes="accent" Content="Continuer"
                    Margin="10,0,0,0" Click="Connect_Click" IsDefault="True"/>
        </Grid>
    </StackPanel>
</Window>
