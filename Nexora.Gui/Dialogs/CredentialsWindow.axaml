<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Gui.Dialogs.CredentialsWindow"
        Title="Nexora · Identifiants FIDO2"
        Width="660" Height="590" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#090D18" RequestedThemeVariant="Dark">
    <Grid Margin="25,23" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="7">
            <TextBlock Text="NEXORA  /  PASSKEYS" Foreground="#A88BFA" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Identifiants enregistrés" Foreground="#F2F5FF" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Consultez les domaines associés à cet authentificateur. Aucune clé privée n'est affichée."
                       Foreground="#9EAFCC" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#17233A" BorderBrush="#293751" BorderThickness="1"
                CornerRadius="10" Margin="0,20,0,14" Padding="12,10">
            <TextBlock x:Name="SubtitleText" Foreground="#B4C4DE" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Background="#111A2C" BorderBrush="#2A3851" BorderThickness="1"
                CornerRadius="13" Padding="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CredentialListPanel" Spacing="9"/>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,17,0,0">
            <TextBlock Text="Suppression définitive uniquement après confirmation." FontSize="11"
                       Foreground="#91A4C1" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Fermer" MinWidth="106" Click="Close_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
