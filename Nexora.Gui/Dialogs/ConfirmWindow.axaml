<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexora.Gui.Dialogs.ConfirmWindow"
        Width="480" SizeToContent="Height" MaxHeight="620"
        CanResize="False" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0B1020" RequestedThemeVariant="Dark">
    <StackPanel Margin="25" Spacing="16">
        <TextBlock Text="NEXORA  /  CONFIRMATION" Foreground="#B79CFF" FontSize="10" FontWeight="Bold"/>
        <Border Background="#151F34" BorderBrush="#34405F" BorderThickness="1" CornerRadius="12" Padding="17,17">
            <ScrollViewer MaxHeight="320">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Foreground="#DAE5F7"/>
            </ScrollViewer>
        </Border>
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Action soumise à confirmation" VerticalAlignment="Center"
                       Foreground="#8498B8" FontSize="11"/>
            <Button Grid.Column="1" Content="Annuler" MinWidth="104" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Grid.Column="2" Content="Confirmer"
                    Classes="danger" MinWidth="112" Margin="9,0,0,0" Click="Confirm_Click"/>
        </Grid>
    </StackPanel>
</Window>
